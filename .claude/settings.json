{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make lint)",
      "Bash(go version)",
      "Bash(go env)",
      "Bash(go doc:*)",
      "Bash(gofmt -l .)",
      "Bash(git check-ignore:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse --abbrev-ref HEAD)",
      "Bash(git submodule status:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(go mod tidy:*)",
      "Bash(go get:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go list:*)",
      "Bash(go test:*)",
      "Bash(git submodule update:*)",
      "Bash(make all:*)",
      "Bash(make geth:*)",
      "Bash(make clean:*)",
      "Bash(make test:*)",
      "Bash(make test-coregeth:*)",
      "Bash(make test-coregeth-features:*)",
      "Bash(make test-coregeth-consensus:*)",
      "Bash(make test-coregeth-chainspecs-coregeth:*)",
      "Bash(make test-coregeth-regression-condensed:*)",
      "Bash(make tests-generate:*)",
      "Bash(make test-evmc:*)",
      "Bash(make hera:*)",
      "Bash(make evmone:*)"
    ],
    "deny": [
      "Bash(go env -w:*)",
      "Bash(go env -w=*)",
      "Bash(go build -toolexec:*)",
      "Bash(go build -toolexec=*)",
      "Bash(go vet -vettool:*)",
      "Bash(go vet -vettool=*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch --force:*)"
    ]
  }
}
